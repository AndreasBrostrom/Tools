#!/bin/bash
set -e
scriptName=$(basename "$(test -L "$0" && readlink "$0" || echo "$0")")
androidRoot="/storage/emulated/0"
androidDefaultDest="$androidRoot/Download"

# Help
fn_help () {
  echo "Usage: $scriptName [FILE] [DEST] [OPTION]"
  echo "Files are uploaded to DEST, or the download directory if DEST is omitted."
  echo ""
  echo "  DEST                  destination folder on the device"
  echo "                        a leading '~/' expands to $androidRoot/"
  echo "                        e.g. ~/DCIM/ -> $androidRoot/DCIM/"
  echo ""
  echo "  -s SERIAL             use device with given serial"
  echo ""
  echo "  --devices             list connected devices"
  echo ""
  echo "  -h, --help            show this help"
  exit 0
}

# Local functions
_fn_resolve_dest () {
    dest=$1
    if [[ -z "$dest" || "$dest" == "." ]]; then
        echo "$androidDefaultDest"
    elif [[ "$dest" == "~/"* || "$dest" == "~" ]]; then
        echo "$androidRoot/${dest#\~}"
    elif [[ "$dest" == /* ]]; then
        echo "$dest"
    else
        echo "$androidRoot/$dest"
    fi
}

_fn_upload_success_message () {
    echo "$(basename "$1"): file have been pushed to $2"
}

# Main functions
fn_default () {
    destDir=$(_fn_resolve_dest "$3")
    remotePath="${destDir%/}/$(basename "$2")"

    if [[ "$1" != "false" ]]; then
        adb -s "$1" -d push "$2" "$remotePath"
    else
        adb -d push "$2" "$remotePath"
    fi
    _fn_upload_success_message "$2" "$remotePath"
    exit 0
}

fn_devices () {
    adb devices -l
    exit 0
}

# Main
main () {
    if [[ $# == 0 ]]; then
        echo "$scriptName: requires an argument"
        exit 1
    fi

    if [[ "$*" == *"-h"* ]] || [[ "$*" == *"--help"* ]]; then fn_help; fi

    device=false
    [[ "$1" == "-s" ]] && device=$2
    [[ -z $device ]] && echo "$scriptName: -s requires an argument" && exit 1

    if [[ "$device" == "false" ]]; then
        if [[ "$1" == "--devices" ]]; then fn_devices; fi
        fn_default "$device" "$1" "$2"
    else
        if [[ "$3" == "--devices" ]]; then fn_devices; fi
        fn_default "$device" "$3" "$4"
    fi
}

main "$@"