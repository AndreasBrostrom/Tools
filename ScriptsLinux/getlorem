#!/bin/bash

scriptName=$(basename "$(test -L "$0" && readlink "$0" || echo "$0")")
isNumber='^[0-9]+$'
USE_X11=false
USE_NONSENSE=false
SERVER="https://lorem.brostrom.online"
SERVER_DISPLAY="${SERVER#http://}"; SERVER_DISPLAY="${SERVER_DISPLAY#https://}"; SERVER_DISPLAY="${SERVER_DISPLAY%%:*}"

fn_help () {
    echo "Usage: $scriptName [OPTION]"
    echo ""
    echo "Prints or writes a random generated text from $SERVER_DISPLAY."
    echo "Each option have 2 optional parameter of a number. For a set amount of sentences define one number:"
    echo "   Exsample: $scriptName -p 1"
    echo "To get a random number between 1 och 3 you define a secondary parameter"
    echo "   Exsample: $scriptName -p 1 3"
    echo ""
    echo "  -p, --print           print a random lorem ipsum text"
    echo "  -w, --write           write a random lorem ipsum text to your cursor location"
    echo "  -c, --clipboard       saves and paste a random lorem ipsum from your clipboard"
    echo "  -n, --nonsense        use nonsense text instead of lorem ipsum (combine with -p, -w, or -c)"
    echo ""
    echo "  --X11                 use X11/xdotool instead of Wayland/ydotool (combine with -w or -c)"
    echo "  -h, --help            show this help"

    exit 0
}

fn_error () {
    echo "$scriptName: $*"
    exit 1
}

fn_endpoint () {
    if [[ "$USE_NONSENSE" == true ]]; then echo "nonsense"; else echo "lorem"; fi
}

fn_print () {
    if [[ ! -z $1 ]] && [[ $1 =~ $isNumber ]]; then _RANDS=$1; else _RANDS=1; fi
    if [[ ! -z $2 ]] && [[ $2 =~ $isNumber ]]; then _RANDE=$2; else _RANDE=1; fi

    RAND=$(($_RANDS + $RANDOM % $_RANDE))
    LOREM="$(curl -s $SERVER/$(fn_endpoint)/sentences/$RAND)"
    echo "$LOREM"
    exit 0
}

fn_clipboard () {
    if [[ ! -z $1 ]] && [[ $1 =~ $isNumber ]]; then _RANDS=$1; else _RANDS=1; fi
    if [[ ! -z $2 ]] && [[ $2 =~ $isNumber ]]; then _RANDE=$2; else _RANDE=1; fi

    RAND=$(($_RANDS + $RANDOM % $_RANDE))
    LOREM="$(curl -s $SERVER/$(fn_endpoint)/sentences/$RAND)"

    if [[ "$USE_X11" == true ]]; then
        command -v xclip >/dev/null 2>&1 || command -v xsel >/dev/null 2>&1 || { echo >&2 "ERROR: Script requires 'xclip' or 'xsel' but neither is installed. Aborting."; exit 1; }
        command -v xdotool >/dev/null 2>&1 || { echo >&2 "ERROR: Script requires 'xdotool' but it's not installed. Aborting."; exit 1; }
        if command -v xclip >/dev/null 2>&1; then
            echo "$LOREM" | xclip -selection clipboard
        else
            echo "$LOREM" | xsel --clipboard --input
        fi
        nohup setsid xdotool key ctrl+v </dev/null >/dev/null 2>&1 &
    else
        command -v wl-copy >/dev/null 2>&1 || { echo >&2 "ERROR: Script requires 'wl-copy' (wl-clipboard) but it's not installed. Aborting."; exit 1; }
        command -v ydotool >/dev/null 2>&1 || { echo >&2 "ERROR: Script requires 'ydotool' but it's not installed. Aborting."; exit 1; }
        echo "$LOREM" | wl-copy
        # Ctrl+V: 29:1 (press Ctrl), 47:1 (press V), 47:0 (release V), 29:0 (release Ctrl)
        nohup setsid ydotool key 29:1 47:1 47:0 29:0 </dev/null >/dev/null 2>&1 &
    fi
    exit 0
}

fn_write () {
    if [[ ! -z $1 ]] && [[ $1 =~ $isNumber ]]; then _RANDS=$1; else _RANDS=1; fi
    if [[ ! -z $2 ]] && [[ $2 =~ $isNumber ]]; then _RANDE=$2; else _RANDE=1; fi

    sleep 0.5
    RAND=$(($_RANDS + $RANDOM % $_RANDE))
    LOREM="$(curl -s $SERVER/$(fn_endpoint)/sentences/$RAND)"

    if [[ "$USE_X11" == true ]]; then
        command -v xdotool >/dev/null 2>&1 || { echo >&2 "ERROR: Script requires 'xdotool' but it's not installed. Aborting."; exit 1; }
        xdotool type --delay 1 "$LOREM"
    else
        command -v ydotool >/dev/null 2>&1 || { echo >&2 "ERROR: Script requires 'ydotool' but it's not installed. Aborting."; exit 1; }
        ydotool type --key-delay 1 "$LOREM"
    fi
    exit 0
}

main () {
    # Strip modifier flags from args before counting/routing
    ARGS=()
    for arg in "$@"; do
        if [[ "$arg" == "--X11" ]]; then
            USE_X11=true
        elif [[ "$arg" == "--nonsense" ]] || [[ "$arg" == "-n" ]]; then
            USE_NONSENSE=true
        else
            ARGS+=("$arg")
        fi
    done
    set -- "${ARGS[@]}"

    if [[ $# -gt 3 ]]; then fn_error "To many arguments"; fi

    if [[ "$*"  == "--help"      ]] || [[ "$1"  == "-h" ]]; then fn_help; fi
    if [[ "$1"  == "--write"     ]] || [[ "$1"  == "-w" ]]; then fn_write $2 $3; fi
    if [[ "$1"  == "--print"     ]] || [[ "$1"  == "-p" ]]; then fn_print $2 $3; fi
    if [[ "$1"  == "--clipboard" ]] || [[ "$1"  == "-c" ]]; then fn_clipboard $2 $3; fi

    if [[ $# == 0 ]]; then fn_print; fi

    fn_error "'$*' invalid argument"
}

main "$@"
